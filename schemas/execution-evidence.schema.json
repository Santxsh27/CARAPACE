{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carapace.example/schemas/execution-evidence.schema.json",
  "title": "CARAPACE Payment Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "contract_id",
    "observed_at",
    "actual_request",
    "actual_request_hash_sha256",
    "idempotency_key",
    "lifecycle",
    "ledger_entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "contract_id": { "type": "string", "minLength": 8 },
    "observed_at": { "type": "string", "format": "date-time" },
    "actual_request": { "type": "object" },
    "actual_request_hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotency_key": { "type": "string", "minLength": 8 },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "DRAFT",
          "USER_CONFIRMED",
          "AUTHORIZED",
          "SUBMITTED",
          "ACCEPTED",
          "SETTLED",
          "FAILED",
          "REVERSED"
        ]
      }
    },
    "settlement_reference": { "type": ["string", "null"] },
    "ledger_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "logical_payment_id",
          "account_ref",
          "counterparty_ref",
          "direction",
          "amount_minor",
          "currency",
          "status"
        ],
        "properties": {
          "entry_id": { "type": "string", "minLength": 1 },
          "logical_payment_id": { "type": "string", "minLength": 1 },
          "account_ref": { "type": "string", "minLength": 1 },
          "counterparty_ref": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["DEBIT", "CREDIT"] },
          "amount_minor": { "type": "integer", "minimum": 0 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "status": { "enum": ["PENDING", "POSTED", "REVERSED"] }
        }
      }
    }
  }
}

