# CARAPACE defaults to the honest offline provider.
CARAPACE_AI_PROVIDER=local
CARAPACE_GEMINI_MODEL=gemini-3.6-flash

# For the Gemini Developer API free tier, use CARAPACE_AI_PROVIDER=gemini and
# place your AI Studio key below in a local .env file. Never commit that file.
GOOGLE_API_KEY=

# For Vertex AI, use CARAPACE_AI_PROVIDER=vertex with Application Default
# Credentials or a Cloud Run service identity. Do not store service-account keys.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Separate per-tenant Release Passport signing keys. The local development
# build can fall back to the demo key; hosted deployments must configure this
# and should replace the local HMAC signer with Cloud KMS.
CARAPACE_PASSPORT_KEYS_JSON=
