{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CARAPACE: Run tests",
      "type": "shell",
      "command": "PYTHONPATH=src python3 -m unittest discover -s tests -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CARAPACE: Verify valid payment",
      "type": "shell",
      "command": "PYTHONPATH=src python3 -m carapace_core verify examples/payment-promise.json examples/execution-valid.json",
      "problemMatcher": []
    },
    {
      "label": "CARAPACE: Build Docker image",
      "type": "shell",
      "command": "docker compose build",
      "problemMatcher": []
    },
    {
      "label": "CARAPACE: Start assurance API",
      "type": "shell",
      "command": "docker compose up --build api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "CARAPACE: Run complete API demo",
      "type": "shell",
      "command": "docker compose --profile tools run --rm --build demo",
      "problemMatcher": []
    },
    {
      "label": "CARAPACE: Test in Docker",
      "type": "shell",
      "command": "docker compose --profile test run --rm --build tests",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
